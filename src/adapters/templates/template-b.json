{
  "schemaVersion": 1,
  "id": "template-b",
  "name": "Serverless API with DynamoDB + SQS",
  "description": "The same API as \"Serverless API with RDS\", reworked for spikes: reads go to DynamoDB, and writes go through an SQS queue to a worker function with a capped concurrency. Run the same lunch rush and compare.",
  "createdAt": "2026-10-14T00:00:00Z",
  "updatedAt": "2026-10-14T00:00:00Z",
  "architecture": {
    "components": [
      {
        "id": "api",
        "type": "api-gateway",
        "name": "API Gateway",
        "config": {
          "ratePerSec": 10000,
          "burst": 5000,
          "overhead": { "kind": "lognormal", "medianMs": 10, "p99Ms": 25 }
        }
      },
      {
        "id": "fn-api",
        "type": "lambda",
        "name": "fn-api",
        "config": {
          "concurrency": 1000,
          "coldStart": { "kind": "lognormal", "medianMs": 300, "p99Ms": 1000 },
          "idleTimeoutSec": 600,
          "computeTime": { "kind": "lognormal", "medianMs": 20, "p99Ms": 80 }
        }
      },
      {
        "id": "orders-read",
        "type": "dynamodb",
        "name": "orders-read",
        "config": {
          "readUnitsPerSec": 2500,
          "writeUnitsPerSec": 500,
          "burstSec": 5,
          "latency": { "kind": "lognormal", "medianMs": 5, "p99Ms": 20 }
        }
      },
      {
        "id": "orders-queue",
        "type": "sqs",
        "name": "orders-queue",
        "config": {
          "consumerMaxConcurrency": 40,
          "sendLatency": { "kind": "lognormal", "medianMs": 10, "p99Ms": 30 }
        }
      },
      {
        "id": "fn-writer",
        "type": "lambda",
        "name": "fn-writer",
        "config": {
          "concurrency": 1000,
          "coldStart": { "kind": "lognormal", "medianMs": 300, "p99Ms": 1000 },
          "idleTimeoutSec": 600,
          "computeTime": { "kind": "lognormal", "medianMs": 20, "p99Ms": 80 }
        }
      },
      {
        "id": "orders-db",
        "type": "rds",
        "name": "orders-db",
        "config": {
          "maxConnections": 90,
          "queryWorkers": 16,
          "queryTime": { "kind": "lognormal", "medianMs": 15, "p99Ms": 60 }
        }
      }
    ],
    "edges": [
      {
        "id": "api->fn-api",
        "from": "api",
        "to": "fn-api",
        "latencyMs": 2,
        "timeoutMs": 29000,
        "retry": { "maxAttempts": 1, "backoff": "none", "baseDelayMs": 0 }
      },
      {
        "id": "fn-api->orders-read",
        "from": "fn-api",
        "to": "orders-read",
        "latencyMs": 1,
        "timeoutMs": 5000,
        "retry": {
          "maxAttempts": 4,
          "backoff": "exponential-jitter",
          "baseDelayMs": 25
        }
      },
      {
        "id": "fn-api->orders-queue",
        "from": "fn-api",
        "to": "orders-queue",
        "latencyMs": 1,
        "timeoutMs": 5000,
        "retry": {
          "maxAttempts": 3,
          "backoff": "exponential-jitter",
          "baseDelayMs": 50
        }
      },
      {
        "id": "orders-queue->fn-writer",
        "from": "orders-queue",
        "to": "fn-writer",
        "latencyMs": 2,
        "timeoutMs": 29000,
        "retry": { "maxAttempts": 1, "backoff": "none", "baseDelayMs": 0 }
      },
      {
        "id": "fn-writer->orders-db",
        "from": "fn-writer",
        "to": "orders-db",
        "latencyMs": 1,
        "timeoutMs": 5000,
        "retry": { "maxAttempts": 1, "backoff": "none", "baseDelayMs": 0 }
      }
    ]
  },
  "workflows": [
    {
      "id": "get-order",
      "name": "Get order",
      "root": {
        "componentId": "api",
        "action": "invoke",
        "calls": [
          {
            "componentId": "fn-api",
            "action": "invoke",
            "calls": [{ "componentId": "orders-read", "action": "read" }]
          }
        ]
      }
    },
    {
      "id": "create-order",
      "name": "Create order",
      "root": {
        "componentId": "api",
        "action": "invoke",
        "calls": [
          {
            "componentId": "fn-api",
            "action": "invoke",
            "calls": [
              {
                "componentId": "orders-queue",
                "action": "enqueue",
                "async": {
                  "componentId": "fn-writer",
                  "action": "invoke",
                  "calls": [{ "componentId": "orders-db", "action": "write" }]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "workloads": [
    {
      "id": "lunch-rush",
      "name": "Lunch rush",
      "durationSec": 60,
      "seed": 42,
      "mix": [
        { "workflowId": "get-order", "weight": 80 },
        { "workflowId": "create-order", "weight": 20 }
      ],
      "profile": [
        { "atSec": 0, "requestsPerSec": 200 },
        { "atSec": 10, "requestsPerSec": 200 },
        { "atSec": 20, "requestsPerSec": 2000 },
        { "atSec": 40, "requestsPerSec": 2000 },
        { "atSec": 50, "requestsPerSec": 200 }
      ]
    }
  ],
  "layout": {
    "nodes": {
      "api": { "x": 0, "y": 100 },
      "fn-api": { "x": 250, "y": 100 },
      "orders-read": { "x": 500, "y": 0 },
      "orders-queue": { "x": 500, "y": 200 },
      "fn-writer": { "x": 750, "y": 200 },
      "orders-db": { "x": 1000, "y": 200 }
    }
  }
}
