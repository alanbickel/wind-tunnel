{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    // Tests in tests/scripts/ import the driver's JavaScript modules, typed by
    // their JSDoc. Only the importing tests are checked, not the scripts.
    "allowJs": true
  },
  "include": ["vite.config.ts", "tests"]
}
